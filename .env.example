# Server Configuration
PORT=4000

# Database
MONGO_CONN=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key

# Nodemailer / Email SMTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Google OAuth
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID=your_google_client_id

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_ADDRESS=Office Address

# Razorpay
RAZORPAY_KEY_ID=rzp_live_or_test_key
RAZORPAY_KEY_SECRET=rzp_secret_key

# Twilio SMS
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number

# OpenCage Geocoding
OPENCAGE_KEY=your_opencage_api_key

# Renflair SMS Gateway
RENFLAIR_API_KEY=your_renflair_key
RENFLAIR_SMS_URL=https://api.renflair.com/sms

# Firebase Service Account (JSON string for Render/Production environment variable, or place serviceAccountKey.json in root)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
